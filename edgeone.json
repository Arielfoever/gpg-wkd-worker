{
	"buildCommand": "node tools/build-edgeone.mjs",
	"installCommand": "echo skip-install",
	"outputDirectory": "./dist",
	"nodeVersion": "22.11.0",
	"rewrites": [
		{
			"source": "/.well-known/openpgpkey/*",
			"destination": "/wkd/:splat.gpg"
		}
	],
	"headers": [
		{
			"source": "/.well-known/openpgpkey/*",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/octet-stream"
				},
				{
					"key": "Access-Control-Allow-Origin",
					"value": "*"
				},
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600"
				}
			]
		},
		{
			"source": "/wkd/*",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/octet-stream"
				},
				{
					"key": "Access-Control-Allow-Origin",
					"value": "*"
				},
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600"
				}
			]
		}
	]
}
